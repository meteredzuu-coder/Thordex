# Wajib — JWT Pinata (buat di pinata.cloud > API Keys). Dipakai server-side saja lewat
# /api/ipfs/file dan /api/ipfs/json, jadi JANGAN pakai prefix NEXT_PUBLIC_.
PINATA_JWT=

# Opsional — gateway IPFS kustom, default https://gateway.pinata.cloud/ipfs
NEXT_PUBLIC_PINATA_GATEWAY=

# Opsional — override alamat kontrak kalau di-deploy ulang / pindah jaringan
NEXT_PUBLIC_TOKEN_FACTORY_ADDRESS=
NEXT_PUBLIC_TREASURY_ADDRESS=
